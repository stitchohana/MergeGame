{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "WebWorker"],
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["@cloudflare/workers-types"],
		"noCheck": true,
		"noEmit": true
	},
	"include": [
		"src/worker/**/*.ts",
		"src/engine/**/*.ts",
		"src/routes/**/*.ts",
		"src/middleware/auth.ts",
		"src/storage/interface.ts",
		"src/storage/d1.ts"
	]
}
