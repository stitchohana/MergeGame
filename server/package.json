{
  "name": "mergegame-server",
  "version": "1.0.0",
  "description": "MergeGame authoritative game server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run worker:check",
    "start": "node dist/index.js",
    "worker:dev": "wrangler dev --config wrangler.toml --local",
    "worker:deploy": "wrangler deploy --config wrangler.toml",
    "worker:check": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "jose": "^6.1.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^10.0.0",
    "@cloudflare/workers-types": "^5.20260721.1",
    "tsx": "^4.19.0",
    "wrangler": "^4.30.0",
    "typescript": "^5.6.0"
  }
}
